FROM ghcr.io/n8n-io/n8n:2.41.6@sha256:87e0bab2c93192e8dd885ff7b0697c22a1bd97489568a8c67cc140fd7dbb342d
COPY workflows/pcl-*.json /opt/pcl/workflows/
COPY scripts/start-n8n.mjs /opt/pcl/start-n8n.mjs
ENV N8N_USER_FOLDER=/data N8N_DIAGNOSTICS_ENABLED=false N8N_VERSION_NOTIFICATIONS_ENABLED=false N8N_PERSONALIZATION_ENABLED=false N8N_COMMUNITY_PACKAGES_ENABLED=false EXECUTIONS_DATA_SAVE_ON_SUCCESS=none EXECUTIONS_DATA_SAVE_ON_ERROR=none EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false EXECUTIONS_DATA_PRUNE=true EXECUTIONS_DATA_MAX_AGE=24
EXPOSE 5678
ENTRYPOINT ["node", "/opt/pcl/start-n8n.mjs"]
