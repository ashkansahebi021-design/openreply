    {
      "parameters": {
        "jsCode": "const settings={};let duplicate=false;\n for(const {json:j} of $('Get Settings').all()){if(j.setting_key==null)continue;if(Object.hasOwn(settings,j.setting_key))duplicate=true;settings[j.setting_key]=j.setting_value;}\n const p=$('Parse Update').first().json;\n const owner=String(settings.TELEGRAM_OWNER_USER_ID || '');const chat=String(settings.TELEGRAM_OWNER_CHAT_ID || '');\n const authorized=!duplicate&&/^\\d+$/.test(owner)&&chat===owner&&p.from_user_id===owner&&p.chat_id===chat&&p.chat_type==='private'&&!p.is_bot;\n return [{json:{...p,authorized,owner_user_id:owner,owner_chat_id:chat}}];"
      },
