      "parameters": {
        "jsCode": "const p=$('Parse Update').first().json;\n const matches=$('Get Approval').all().map(x=>x.json).filter(j=>j.id!=null&&String(j.approval_ref)===p.approval_ref);\n const row=matches.length===1?matches[0]:null;\n const expiry=Date.parse(row?.expires_at || '');\n const expired=!Number.isFinite(expiry)||expiry<=Date.now();\n const actionable=$('Authorize').first().json.authorized===true&&!!row&&!expired&&row.status==='awaiting_approval'&&String(row.awaiting_edit).toLowerCase()!=='true'&&Number(row.draft_version)===p.callback_version&&String(row.telegram_message_id || '')===p.tg_message_id&&['apv','rej','edt'].includes(p.action);\n return [{json:{...p,row_id:row?.id,exists:!!row,expired,status:row?.status || '',actionable,provider_message_id:row?.provider_message_id || '',sender_id:row?.sender_id || '',draft_reply_fa:row?.draft_reply_fa || '',category:row?.category || '',draft_version:Number(row?.draft_version || 0)}}];"
