      "parameters": {
        "jsCode": "const u=$json.body || $json || {};\n const cq=u.callback_query;\n const m=cq?.message || u.message || {};\n const user=cq?.from || u.message?.from || {};\n const match=/^(apv|edt|rej):([A-Za-z0-9_-]{1,32}):([1-9]\\d{0,5})$/.exec(String(cq?.data || ''));\n return [{json:{update_type:cq?'callback':u.message?'message':'other',from_user_id:String(user.id || ''),is_bot:user.is_bot===true,chat_id:String(m.chat?.id || ''),chat_type:m.chat?.type || '',action:match?match[1]:'',approval_ref:match?match[2]:'',callback_version:match?Number(match[3]):0,callback_query_id:String(cq?.id || ''),tg_message_id:String(m.message_id || ''),reply_to_message_id:String(m.reply_to_message?.message_id || ''),text:typeof m.text==='string'?m.text:''}}];"
      },
      "id": "777966db-88bc-464c-9109-d93a757afcba",
