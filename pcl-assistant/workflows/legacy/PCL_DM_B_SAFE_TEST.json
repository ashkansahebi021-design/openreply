    {
      "parameters": {
        "jsCode": "const p=$('Parse Update').first().json;\n const rows=$('Get Awaiting Edit').all().map(x=>x.json).filter(j=>j.id!=null&&j.status==='awaiting_edit'&&String(j.awaiting_edit).toLowerCase()==='true'&&String(j.telegram_message_id || '')===p.reply_to_message_id);\n const row=rows.length===1?rows[0]:null;\n const expiry=Date.parse(row?.expires_at || '');\n const new_text=p.text;\n const has_pending=$('Authorize').first().json.authorized===true&&p.update_type==='message'&&Boolean(p.reply_to_message_id)&&!!row&&Number.isFinite(expiry)&&expiry>Date.now()&&Boolean(new_text.trim())&&new_text.length<=1000&&Number.isInteger(Number(row.draft_version))&&Number(row.draft_version)>0;\n return [{json:{has_pending,row_id:row?.id,approval_ref:row?.approval_ref || '',provider_message_id:row?.provider_message_id || '',sender_id:row?.sender_id || '',category:row?.category || '',old_version:Number(row?.draft_version || 0),new_version:Number(row?.draft_version || 0)+1,new_text,chat_id:p.chat_id,reply_to_message_id:p.reply_to_message_id}}];"
