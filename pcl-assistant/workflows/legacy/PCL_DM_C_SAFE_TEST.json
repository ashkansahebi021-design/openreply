    {
      "parameters": {
        "jsCode": "const settings={};const errors=[];\n for(const {json:j} of $('Get Settings').all()){if(j.setting_key==null)continue;if(Object.hasOwn(settings,j.setting_key))errors.push('duplicate_settings');settings[j.setting_key]=j.setting_value;}\n const input=$('Approval Input').first().json;\n const ref=String(input.approval_ref || '');const version=Number(input.draft_version);\n const approvals=$('Get Approval').all().map(x=>x.json).filter(j=>j.id!=null&&j.approval_ref===ref);\n const messages=$('Get Message').all().map(x=>x.json).filter(j=>j.id!=null&&j.approval_ref===ref);\n const a=approvals.length===1?approvals[0]:{};const m=messages.length===1?messages[0]:{};\n if(approvals.length!==1||messages.length!==1)errors.push('missing_or_duplicate_record');\n if(!/^PCL[A-Za-z0-9_-]{1,29}$/.test(ref)||!Number.isInteger(version)||version<1)errors.push('invalid_request');\n if(a.status!=='approved'||String(a.awaiting_edit).toLowerCase()==='true')errors.push('not_approved');\n if(Number(a.draft_version)!==version||Number(m.draft_version)!==version)errors.push('version_mismatch');\n for(const key of ['account_id','provider_message_id','sender_id','conversation_id'])if(!a[key]||String(a[key])!==String(m[key]))errors.push('record_mismatch_'+key);\n if(!settings.IG_ACCOUNT_ID||String(a.account_id)!==String(settings.IG_ACCOUNT_ID))errors.push('account_mismatch');\n if(typeof a.draft_reply_fa!=='string'||!a.draft_reply_fa.trim()||a.draft_reply_fa.length>1000||a.draft_reply_fa!==m.draft_reply_fa)errors.push('text_mismatch');\n if(['sent','sending','simulated','unknown_delivery','rejected','window_expired'].includes(m.status))errors.push('message_terminal_or_inflight');\n const now=Date.now();const expiry=Date.parse(a.expires_at || '');const decided=Date.parse(a.decided_at || '');\n if(!Number.isFinite(expiry)||expiry<=now)errors.push('approval_expired_or_missing');\n if(!settings.TELEGRAM_OWNER_USER_ID||String(a.decided_by)!==String(settings.TELEGRAM_OWNER_USER_ID)||!Number.isFinite(decided)||decided>now+60000)errors.push('owner_decision_missing');\n const received=Date.parse(m.received_at || '');\n const wh=Number(settings.MESSAGING_WINDOW_HOURS);const windowHours=Number.isFinite(wh)&&wh>0?Math.min(wh,24):24;\n const age=now-received;const within_window=Number.isFinite(received)&&age>=0&&age<windowHours*3600000-60000;\n if(!Number.isFinite(received)||received>now)errors.push('invalid_received_time');\n const conversation=$('Get Conversation Messages').all().map(x=>x.json).filter(j=>j.id!=null);\n if(!conversation.some(j=>j.provider_message_id===m.provider_message_id&&String(j.account_id)===String(m.account_id)))errors.push('conversation_missing');\n for(const j of conversation){\n  if(String(j.account_id)!==String(m.account_id)||j.conversation_id!==m.conversation_id){errors.push('conversation_mismatch');continue;}\n  const t=Date.parse(j.received_at || '');\n  if(!Number.isFinite(t)||(j.provider_message_id!==m.provider_message_id&&t>=received))errors.push('newer_or_unordered_message');\n }\n const test_mode=String(settings.TEST_MODE).toLowerCase()!=='false';\n const kill_switch=String(settings.OUTBOUND_KILL_SWITCH).toLowerCase()!=='false';\n return [{json:{approval_ref:ref,draft_version:version,approval_row_id:a.id,message_row_id:m.id,message_id:a.provider_message_id || '',draft_reply_fa:a.draft_reply_fa || '',recipient_igsid:a.sender_id || '',ig_account_id:a.account_id || '',test_mode,kill_switch,within_window,received_at:m.received_at || '',valid_context:errors.length===0,block_reasons:[...new Set(errors)]}}];"
      },
