        "text": "={{ (() => { const e=s => String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); const c=$(\"Build Context\").first().json;const d=$(\"Validate Draft\").first().json;const r=$(\"Prepare Records\").first().json;return '🧪 پیام آزمایشی — ارسال واقعی مسدود است\\n👤 فرستنده: '+e(c.sender_id)+'\\n\\nپیام مشتری (پیش‌نمایش):\\n'+e(c.message_text.slice(0,900))+(c.message_text.length>900?'\\n[ادامه در پیام اصلی]':'')+'\\n\\nخلاصه:\\n'+e(d.summary_fa)+'\\n\\nپاسخ پیشنهادی کامل:\\n'+e(d.draft_reply_fa)+(d.needs_owner_decision?'\\n⚠️ نیازمند تصمیم مالک':'')+'\\nاطلاعات ناقص: '+e(d.missing_information.join('، '))+'\\nکد: '+e(r.approval_ref)+' | نسخه: 1'; })() }}",
