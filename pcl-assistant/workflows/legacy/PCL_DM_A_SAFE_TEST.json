        "jsonSchemaExample": "{\"category\":\"sales\",\"summary_fa\":\"خلاصهٔ کوتاه پیام مشتری به فارسی\",\"draft_reply_fa\":\"متن پاسخ پیشنهادی به فارسی\",\"needs_owner_decision\":false,\"missing_information\":[\"اطلاعاتی که برای پاسخ کامل لازم است\"]}"
      },
      "id": "705b40c5-e382-412c-b318-d588a5b2258c",
      "name": "Draft Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        464,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const chain=$('LLM Draft').first().json || {};\n let out=chain.output ?? chain.text ?? chain;\n if(typeof out==='string'){try{out=JSON.parse(out);}catch{out={};}}\n if(!out || typeof out!=='object' || Array.isArray(out))out={};\n const allowed=['sales','pricing','support','collaboration','feedback','spam','other'];\n const errs=[];\n const category=typeof out.category==='string'?out.category:'';\n const summary_fa=typeof out.summary_fa==='string'?out.summary_fa:'';\n const draft_reply_fa=typeof out.draft_reply_fa==='string'?out.draft_reply_fa:'';\n if(!allowed.includes(category))errs.push('category');\n if(!summary_fa.trim()||summary_fa.length>350)errs.push('summary_fa');\n if(!draft_reply_fa.trim()||draft_reply_fa.length>1000)errs.push('draft_reply_fa');\n if(typeof out.needs_owner_decision!=='boolean')errs.push('needs_owner_decision');\n const missing=out.missing_information;\n if(!Array.isArray(missing)||missing.length>5||missing.some(x=>typeof x!=='string'||x.length>100))errs.push('missing_information');\n const missing_information=Array.isArray(missing)?missing.filter(x=>typeof x==='string').slice(0,5).map(x=>x.slice(0,100)):[];\n const text=$('Build Context').first().json.message_text;\n const sensitive=['pricing','collaboration','sales'].includes(category)||/قیمت|تخفیف|قرارداد|پرداخت|اسپانسر|همکاری|پروژه|price|discount|contract|payment|sponsor|partnership/i.test(text);\n return [{json:{valid:errs.length===0,validation_errors:errs,category:allowed.includes(category)?category:'other',summary_fa:summary_fa.slice(0,350),draft_reply_fa,needs_owner_decision:sensitive||out.needs_owner_decision===true||missing_information.length>0,missing_information,missing_information_str:JSON.stringify(missing_information)}}];"
      },
