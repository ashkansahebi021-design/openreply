    {
      "parameters": {
        "jsCode": "const root=$json.body || $json || {};\n const events=[];\n for(const entry of Array.isArray(root.entry)?root.entry:[]){\n  for(const item of Array.isArray(entry.messaging)?entry.messaging:[])events.push({entry,item});\n }\n if(events.length>1)throw Error('PCL_BATCH_BLOCKED: this test build handles one event; production needs durable fan-out of EVERY event.');\n const {entry={},item={}}=events[0] || {};\n const account_id=String(entry.id || '');\n const sender_id=String(item.sender?.id || '');\n const msg=item.message || {};\n const provider_message_id=typeof msg.mid==='string'?msg.mid:'';\n const message_text=typeof msg.text==='string'?msg.text:'';\n const attachment_type=Array.isArray(msg.attachments)&&msg.attachments.length?String(msg.attachments[0].type || 'unknown'):'';\n const ms=Number(item.timestamp);\n const timeValid=Number.isFinite(ms)&&ms>0&&ms<=Date.now()+60000;\n const is_echo=msg.is_echo===true || sender_id===account_id;\n const has_message=Boolean(account_id&&sender_id&&provider_message_id&&timeValid&&!is_echo&&(message_text||attachment_type)&&String(item.recipient?.id || '')===account_id);\n return [{json:{account_id,sender_id,sender_username:'',provider_message_id,message_text,attachment_type,received_at:timeValid?new Date(ms).toISOString():'',conversation_id:account_id+':'+sender_id,is_echo,has_message}}];"
      },
