    {
      "parameters": {
        "jsCode": "const settings={};\n for(const {json:j} of $('Get Settings').all()){\n  if(j.setting_key==null)continue;\n  if(Object.hasOwn(settings,j.setting_key))throw Error('PCL_CONFIG: duplicate setting keys.');\n  settings[j.setting_key]=j.setting_value;\n }\n if(String(settings.TEST_MODE).toLowerCase()==='false')throw Error('PCL_TEST_ONLY: real ingress is not commissioned.');\n const p=$('Parse Message').first().json;\n if(String(settings.IG_ACCOUNT_ID || '')!==p.account_id)throw Error('PCL_CONFIG: account mismatch.');\n if(!/^\\d+$/.test(String(settings.TELEGRAM_OWNER_CHAT_ID || '')) || String(settings.TELEGRAM_OWNER_CHAT_ID)!==String(settings.TELEGRAM_OWNER_USER_ID))throw Error('PCL_CONFIG: set owner private chat ID and matching numeric user ID.');\n const brand_block=$('Get Brand Info').all().filter(({json:j})=>String(j.is_confirmed).toLowerCase()==='true').map(({json:j})=>'- '+String(j.info_key || '')+': '+String(j.value_fa || j.value_en || '').slice(0,2000)).join('\\n').slice(0,10000) || '(اطلاعات تأییدشده‌ای موجود نیست)';\n const raw=Number(settings.APPROVAL_TTL_MINUTES);\n const approval_ttl_minutes=Number.isFinite(raw)&&raw>0?Math.min(raw,1440):60;\n return [{json:{...p,owner_chat_id:String(settings.TELEGRAM_OWNER_CHAT_ID),ig_account_id:p.account_id,approval_ttl_minutes,brand_block,requires_manual_review:Boolean(p.attachment_type)||!p.message_text.trim()||p.message_text.length>4000}}];"
      },
      "id": "aadbc6ec-7ba6-41aa-b8aa-88f030da98df",
      "name": "Build Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
