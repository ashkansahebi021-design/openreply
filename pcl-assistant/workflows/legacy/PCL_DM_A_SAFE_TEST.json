        "jsCode": "const c=$('Build Context').first().json;\n const now=Date.now();\n const expiry=Math.min(now+c.approval_ttl_minutes*60000,Date.parse(c.received_at)+24*3600000-60000);\n if(!Number.isFinite(expiry)||expiry<=now)throw Error('PCL_EXPIRED: incoming message too old for this test.');\n const approval_ref='PCL'+String($execution.id).replace(/[^A-Za-z0-9_-]/g,'').slice(-20);\n return [{json:{approval_ref,draft_version:1,created_at:new Date(now).toISOString(),expires_at:new Date(expiry).toISOString()}}];"
