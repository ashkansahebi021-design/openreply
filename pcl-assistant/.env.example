# Never add real secrets to git. Owner enters these through a hosting secrets UI.
DATABASE_PATH=/data/pcl.sqlite3
IG_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0
META_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
# Engineer sets true only after authenticated permission/subscription/account checks.
META_CAPABILITIES_VERIFIED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Reserved for an explicitly approved stronger-model path; disabled by default.
OPENAI_STRONG_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_USER_ID=
# Public FAQ + human inquiries; does not enable a model or Instagram delivery.
PUBLIC_TELEGRAM_ENABLED=false
# HTTPS gateway origin, used for engineer-only Telegram commissioning.
PUBLIC_BASE_URL=
INTERNAL_API_TOKEN=
DRY_RUN=true
OUTBOUND_ENABLED=false
AUTO_REPLY_CONFIDENCE=0.88
AI_DAILY_CALL_LIMIT=100
APPROVAL_TTL_SECONDS=3600
CONTEXT_LIMIT=12
RETENTION_DAYS=30
SEND_PER_MINUTE=10
N8N_ENCRYPTION_KEY=
PCL_INTERNAL_URL=http://gateway:8080
# Engineer selects and pins a supported n8n release before deployment.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.41.6
PUBLIC_HOST=localhost
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
